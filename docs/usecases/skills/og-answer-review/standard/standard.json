{
  "name": "Стандарт качества ответов на обращения граждан (базовый)",
  "version": "1.0",
  "about": "Базовые критерии по общим требованиям 59-ФЗ (ответ по существу каждого поставленного вопроса) и типичным признакам отписки и формализма. Орган правит этот файл под свой стандарт: фразы (регулярные выражения, без учёта регистра), пороги, правила вердикта. В отчёте всегда указываются name и version.",
  "body": {
    "start_patterns": [
      "^\\s*уважаем"
    ],
    "end_patterns": [
      "^\\s*с уважением",
      "^\\s*SS\\^",
      "^\\s*<должность",
      "^\\s*приложени[ея]:"
    ],
    "min_words": 25,
    "short_answer_weight": 3
  },
  "criteria": {
    "otpiska": {
      "label": "Отписка",
      "about": "Шаблонные фразы, которые создают видимость ответа без содержания.",
      "patterns": [
        {
          "re": "рассмотрен\\w*\\s+в\\s+установленном\\s+порядке",
          "weight": 2,
          "hint": "«рассмотрено в установленном порядке» — не сказано, что решено"
        },
        {
          "re": "находится\\s+на\\s+контроле",
          "weight": 2,
          "hint": "«на контроле» без сроков и мер"
        },
        {
          "re": "(?:будет|будут)\\s+рассмотрен\\w*\\s+(?:при\\s+наличии|по\\s+мере)",
          "weight": 2,
          "hint": "обещание «при наличии/по мере» без срока"
        },
        {
          "re": "при\\s+наличии\\s+(?:финансирования|средств|возможности)",
          "weight": 2,
          "hint": "«при наличии финансирования» без срока и решения"
        },
        {
          "re": "в\\s+пределах\\s+(?:своей\\s+)?компетенции",
          "weight": 1,
          "hint": "«в пределах компетенции» вместо ответа"
        },
        {
          "re": "(?:вопрос|вопросы)\\s+(?:будет|будут)\\s+(?:изучен|проработан)\\w*",
          "weight": 2,
          "hint": "«вопрос будет изучен» без результата"
        },
        {
          "re": "в\\s+(?:установленные|кратчайшие|разумные)\\s+сроки",
          "weight": 1,
          "hint": "срок без даты"
        },
        {
          "re": "все\\s+(?:заявленные|изложенные)\\s+(?:вопросы|мероприятия)\\s+\\w*\\s*(?:рассмотрен|решен|выполнен)",
          "weight": 1,
          "hint": "обобщённое «всё решено» без подробностей"
        },
        {
          "re": "(?:принят[аоы]?\\s+к\\s+сведению|информация\\s+принята)",
          "weight": 2,
          "hint": "«принято к сведению» — нет ответа по существу"
        },
        {
          "re": "дополнительных\\s+мер\\s+не\\s+требуется",
          "weight": 1,
          "hint": "отказ от мер без обоснования"
        }
      ],
      "remark_score": 1,
      "violation_score": 3
    },
    "formalism": {
      "label": "Формализм и канцелярит",
      "about": "Канцеляризмы, отглагольные существительные, длинные предложения — ответ трудно понять.",
      "kanceliarisms": [
        "в\\s+целях",
        "в\\s+рамках",
        "в\\s+соответствии\\s+с",
        "на\\s+основании\\s+изложенного",
        "доводим\\s+до\\s+(?:вашего\\s+)?сведения",
        "вышеуказанн\\w*",
        "вышеизложенн\\w*",
        "данн(?:ый|ая|ое|ые|ого|ой|ом|ым|ых)\\b",
        "осуществля\\w*",
        "осуществлен\\w*",
        "производ(?:ится|ятся|ство\\s+работ)",
        "проведени[ея]\\s+работ",
        "надлежащ\\w*",
        "в\\s+настоящее\\s+время",
        "по\\s+вопросу",
        "согласно\\s+(?:действующему|вышеуказанному)",
        "в\\s+установленном\\s+порядке",
        "является"
      ],
      "nominal_suffix": "\\w{4,}(?:ение|ание|ация|ость|ство)\\b",
      "per_1000_remark": 25,
      "per_1000_violation": 45,
      "avg_sentence_words_remark": 22,
      "avg_sentence_words_violation": 30,
      "long_sentence_words": 40
    },
    "coverage": {
      "label": "Ответ на каждый вопрос",
      "about": "Каждый вопрос обращения (по классификатору) должен быть освещён в тексте. Названия вопросов ТОТК казённые, поэтому совпадение ищется по основам слов; не освещён ни один вопрос — текст не по теме (нарушение), часть — замечание.",
      "min_share": 0.34,
      "stop_words": [
        "вопрос",
        "вопросы",
        "другие",
        "иные",
        "прочие",
        "общие",
        "граждан",
        "связи",
        "также",
        "порядок",
        "деятельность",
        "работа",
        "сфере",
        "области",
        "органов",
        "числе",
        "том",
        "вне"
      ],
      "none_covered_is_violation": true,
      "partial_is_violation": false
    },
    "specificity": {
      "label": "Конкретика",
      "about": "Проверяемые факты: даты, сроки, суммы, адреса, конкретные действия и ответственные. Для результатов из soft_for_results (разъяснение) отсутствие конкретики — только замечание.",
      "patterns": [
        {
          "re": "\\b\\d{1,2}\\.\\d{1,2}\\.\\d{2,4}\\b",
          "kind": "дата"
        },
        {
          "re": "\\b\\d{1,2}\\s+(?:января|февраля|марта|апреля|мая|июня|июля|августа|сентября|октября|ноября|декабря)",
          "kind": "дата"
        },
        {
          "re": "\\bдо\\s+(?:конца\\s+)?(?:\\d|январ|феврал|март|апрел|ма[яй]|июн|июл|август|сентябр|октябр|ноябр|декабр|\\d{4})",
          "kind": "срок"
        },
        {
          "re": "\\b\\d[\\d\\s]*(?:руб|тыс|млн|кв\\.?\\s*м|м2|метр|шт)",
          "kind": "объём или сумма"
        },
        {
          "re": "\\b(?:ул\\.|улиц[аеы]|д\\.|дом[ау]?\\s+\\d|пр-т|проспект)",
          "kind": "адрес"
        },
        {
          "re": "\\b(?:выполн(?:ил[аи]?|ен[аоы]?|ены)\\b|установ(?:ил[аи]?|лен[аоы]?)\\b|отремонтирова(?:л[аи]?|н[аоы]?)\\b|замен(?:ил[аи]?|[её]н[аоы]?)\\b|организова(?:л[аи]?|н[аоы]?)\\b|назнач(?:ил[аи]?|ен[аоы]?)\\b|включ(?:ил[аи]?|ен[аоы]?)\\b|выдел(?:ил[аи]?|ен[аоы]?)\\b|(?:провел[аи]?|проведен[аоы]?)\\b|восстанов(?:ил[аи]?|лен[аоы]?)\\b|устран(?:ил[аи]?|ен[аоы]?)\\b|направ(?:ил[аи]?|лен[аоы]?)\\s+(?:предписани|требовани|запрос))",
          "kind": "действие"
        }
      ],
      "min_kinds_remark": 2,
      "min_kinds_violation": 1,
      "soft_for_results": [
        "Explained"
      ]
    },
    "result_consistency": {
      "label": "Соответствие результату рассмотрения",
      "about": "Текст должен подтверждать результат, указанный в RX.",
      "action_results": [
        "ActionsTaken",
        "Supported"
      ],
      "action_patterns": [
        "выполн(?:ил[аи]?|ен[аоы]?|ены)\\b",
        "установ(?:ил[аи]?|лен[аоы]?)\\b",
        "отремонтирова(?:л[аи]?|н[аоы]?)\\b",
        "замен(?:ил[аи]?|[её]н[аоы]?)\\b",
        "организова(?:л[аи]?|н[аоы]?)\\b",
        "назнач(?:ил[аи]?|ен[аоы]?)\\b",
        "включ(?:ил[аи]?|ен[аоы]?)\\b",
        "выдел(?:ил[аи]?|ен[аоы]?)\\b",
        "(?:провел[аи]?|проведен[аоы]?)\\b",
        "восстанов(?:ил[аи]?|лен[аоы]?)\\b",
        "устран(?:ил[аи]?|ен[аоы]?)\\b",
        "направ(?:ил[аи]?|лен[аоы]?)\\s+(?:предписани|требовани|запрос)",
        "поддержан[аоы]?\\b",
        "принят[оаы]?\\s+решени"
      ],
      "refusal_results": [
        "NotSupported",
        "Denied"
      ],
      "reason_patterns": [
        "в\\s+связи\\s+с",
        "поскольку",
        "так\\s+как",
        "по\\s+причине",
        "согласно",
        "в\\s+соответствии\\s+с",
        "не\\s+относится",
        "не\\s+предусмотрен"
      ],
      "appeal_patterns": [
        "обжалова",
        "вправе\\s+обратиться",
        "можете\\s+обратиться\\s+в\\s+суд",
        "в\\s+судебном\\s+порядке",
        "вышестоящ"
      ],
      "explained_results": [
        "Explained"
      ],
      "explanation_patterns": [
        "разъясня",
        "сообщаем,?\\s+что",
        "порядок",
        "для\\s+этого",
        "необходимо",
        "вправе",
        "можете"
      ]
    },
    "form": {
      "label": "Оформление",
      "about": "Остатки шаблона, обращение к заявителю, подпись, недопустимая лексика.",
      "placeholder_patterns": [
        "_{4,}",
        "<[^<>\\n]{3,60}>",
        "место\\s+для\\s+ввода\\s+текста",
        "уважаем\\w*\\s*\\(\\w+\\)",
        "^\\s*текст\\s+письма\\s*$"
      ],
      "greeting_pattern": "[Уу]важаем\\w+\\s+[А-ЯЁ][а-яё]+(?:\\s+[А-ЯЁ][а-яё]+)?\\s*!",
      "informal_patterns": [
        "\\bшеф\\b",
        "\\bок\\b",
        "\\bкороче\\b",
        "\\bвроде\\b",
        "\\bщас\\b",
        "!!+",
        "\\)\\)+"
      ],
      "signature_patterns": [
        "<подписант>",
        "<должность\\s+подписанта>"
      ]
    },
    "timeliness": {
      "label": "Срок ответа",
      "about": "Ответ зарегистрирован не позже срока обращения (с учётом продления в RX).",
      "remark_days": 0,
      "violation_days": 1
    },
    "personal_data": {
      "label": "Персональные данные в тексте",
      "about": "Контакты и документы граждан в теле ответа (реквизиты бланка организации не проверяются).",
      "patterns": [
        "[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+",
        "(?<!\\d)(?:\\+7|8)[\\s(-]*\\d{3}[\\s)-]*\\d{3}[\\s-]*\\d{2}[\\s-]*\\d{2}(?!\\d)",
        "(?<!\\d)\\d{3}-\\d{3}-\\d{3}[ -]\\d{2}(?!\\d)",
        "паспорт\\w*[^\\n]{0,20}?(?<!\\d)\\d{2}\\s?\\d{2}\\s?\\d{6}"
      ]
    }
  },
  "verdicts": [
    {
      "label": "Отписка",
      "any_violation": [
        "otpiska"
      ]
    },
    {
      "label": "Отписка",
      "all_violations": [
        "coverage",
        "specificity"
      ]
    },
    {
      "label": "Формальный ответ",
      "any_violation": [
        "formalism",
        "specificity"
      ]
    },
    {
      "label": "Ответ с нарушениями",
      "any_violation": [
        "coverage",
        "result_consistency",
        "form",
        "timeliness",
        "personal_data"
      ]
    },
    {
      "label": "Есть замечания",
      "any_remark": [
        "otpiska",
        "formalism",
        "coverage",
        "specificity",
        "result_consistency",
        "form",
        "timeliness",
        "personal_data"
      ]
    }
  ],
  "default_verdict": "По существу",
  "bad_verdicts": [
    "Отписка",
    "Формальный ответ",
    "Ответ с нарушениями"
  ]
}
